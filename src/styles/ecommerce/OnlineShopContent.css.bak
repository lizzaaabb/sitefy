@import url('https://cdn.jsdelivr.net/npm/@fontsource/firago@5.2.5/index.min.css');
@import url('https://fonts.cdnfonts.com/css/pp-neue-montreal');

.oss-container {
  --bg: #ffffff;
  --text: #14110c;
  --muted: rgba(20, 17, 12, 0.55);
  --faint: rgba(20, 17, 12, 0.32);
  --line: rgba(20, 17, 12, 0.08);
  --surface: #faf8f4;
  --gold: #c9a05c;
  --gold-deep: #a5824a;
  --gold-light: #e3c489;
  --gold-tint: rgba(201, 160, 92, 0.08);
  --gold-grad: linear-gradient(120deg, #57503a, #8a7a52 55%, #b89b5e);
  --gold-soft: linear-gradient(150deg, #b89b5e, #8a7a52 95%);
  --green: #1f7a4d;
  --green-tint: rgba(47, 158, 110, 0.12);

  background: var(--bg);
  color: var(--text);
  padding: 120px 30px;
  transition: background 0.3s ease, color 0.3s ease;
}

[data-theme='dark'] .oss-container {
  --bg: #000000;
  --text: #f2ede2;
  --muted: rgba(242, 237, 226, 0.55);
  --faint: rgba(242, 237, 226, 0.32);
  --line: rgba(242, 237, 226, 0.1);
  --surface: #14110c;
  --gold-tint: rgba(201, 160, 92, 0.12);
}

/* ---------- Header ---------- */

.oss-header {
  max-width: 560px;
  margin: 0 auto 44px;
  text-align: center;
}

.oss-heading {
  margin: 0 0 16px;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.2;
  color: var(--text);
}

.oss-description {
  margin: 0 auto;
  max-width: 460px;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 1.02rem;
  line-height: 1.6;
  color: var(--muted);
}

.oss-heading.eng,
.oss-description.eng,
.oss-navbtn.eng,
.oss-vtitle.eng,
.oss-pn.eng,
.oss-cn.eng,
.oss-on.eng,
.oss-lbl.eng,
.oss-caption.eng,
.oss-csum-row.eng,
.oss-csum-tot.eng {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-feature-settings: normal;
}

.oss-heading.eng { letter-spacing: -0.01em; }

/* ---------- Shop shell ---------- */

.oss-shop {
  max-width: 600px;
  margin: 0 auto;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: var(--bg);
  overflow: hidden;
  box-shadow:
    0 3px 8px rgba(120, 100, 60, 0.05),
    0 30px 70px -34px rgba(80, 60, 20, 0.35);
}

/* ---------- Header bar ---------- */

.oss-hdr {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 20px;
  background: linear-gradient(180deg, var(--surface), var(--bg));
  border-bottom: 1px solid var(--line);
}

.oss-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.oss-brand-mark {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: var(--gold-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(133, 124, 85, 0.35);
}

.oss-brand-mark svg { width: 14px; height: 14px; stroke: #fff; }

.oss-brand-name {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.14em;
  color: var(--text);
}

.oss-brand-name b { color: var(--gold-deep); }

.oss-nav {
  display: flex;
  gap: 2px;
  margin: 0 auto;
}

.oss-navbtn {
  position: relative;
  border: none;
  background: none;
  cursor: pointer;
  padding: 7px 14px;
  border-radius: 999px;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 12.5px;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  transition: color 0.3s ease;
}

.oss-navbtn::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 3px;
  transform: translateX(-50%) scaleX(0);
  width: 14px;
  height: 2px;
  border-radius: 2px;
  background: var(--gold-grad);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.oss-navbtn:hover { color: var(--gold-deep); }
.oss-navbtn:hover::after { transform: translateX(-50%) scaleX(1); }

.oss-navbtn.is-on {
  color: var(--gold-deep);
  font-weight: 600;
}

.oss-navbtn.is-on::after { transform: translateX(-50%) scaleX(1); }

.oss-hdr-icons {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}

.oss-hicon {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  position: relative;
  transition: background 0.3s ease, color 0.3s ease;
  cursor: pointer;
}

.oss-hicon:hover { background: var(--gold-tint); color: var(--gold-deep); }
.oss-hicon svg { width: 16px; height: 16px; stroke: currentColor; }

.oss-hbadge {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--gold-grad);
  color: #fff;
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 8px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 5px rgba(133, 124, 85, 0.5);
}

/* ---------- Screen ---------- */

.oss-screen {
  position: relative;
  background: var(--bg);
}

.oss-view {
  padding: 18px 20px 22px;
  animation: oss-fade 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes oss-fade {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.oss-vhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.oss-vtitle {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text);
}

.oss-vsub {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 11px;
  color: var(--faint);
}

.oss-prod {
  stroke: #fff;
  fill: none;
  stroke-width: 1.25;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 2px 5px rgba(60, 45, 15, 0.25));
}

/* ---------- Catalog ---------- */

.oss-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.oss-pcard {
  border-radius: 16px;
  overflow: hidden;
  background: var(--bg);
  border: 1px solid var(--line);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  cursor: pointer;
}

.oss-pcard:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 32px -18px rgba(133, 124, 85, 0.5);
  border-color: var(--gold-light);
}

.oss-pimg {
  aspect-ratio: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold-soft);
}

.oss-pimg .oss-prod { width: 44%; height: 44%; }

.oss-pfav {
  position: absolute;
  top: 9px;
  right: 9px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-deep);
  box-shadow: 0 2px 6px rgba(80, 60, 20, 0.15);
}

.oss-pfav svg { width: 12px; height: 12px; }

.oss-pmeta { padding: 11px 13px 13px; }

.oss-pn {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 12px;
  font-weight: 500;
  margin-bottom: 5px;
  color: var(--text);
}

.oss-prow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.oss-pp {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--gold-deep);
}

.oss-padd {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: var(--gold-grad);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  line-height: 1;
  box-shadow: 0 4px 10px rgba(133, 124, 85, 0.35);
}

.oss-catrow2 {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 14px;
  padding: 13px 15px;
  border-radius: 14px;
  background: var(--surface);
  border: 1px solid var(--line);
}

.oss-catrow2-ic {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.oss-catrow2-ic .oss-prod { width: 54%; height: 54%; }

.oss-catrow2-txt {
  flex: 1;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 12.5px;
  color: var(--muted);
}

.oss-catrow2-txt b { color: var(--text); font-weight: 600; }

.oss-catrow2-arrow {
  color: var(--gold-deep);
  font-size: 16px;
  flex-shrink: 0;
}

/* ---------- Cart ---------- */

.oss-crow {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 15px;
  border-radius: 14px;
  background: var(--surface);
  margin-bottom: 12px;
}

.oss-cimg {
  width: 56px;
  height: 56px;
  border-radius: 13px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold-soft);
}

.oss-cimg .oss-prod { width: 50%; height: 50%; }

.oss-cinfo { flex: 1; }

.oss-cn {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--text);
}

.oss-cqty {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 6px;
}

.oss-cqty span {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: var(--gold-deep);
  cursor: pointer;
}

.oss-cqty b {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 12px;
  min-width: 14px;
  text-align: center;
  color: var(--text);
}

.oss-cp {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--gold-deep);
  min-width: 52px;
  text-align: right;
}

.oss-csum {
  margin-top: 14px;
  padding: 16px 18px;
  border-radius: 14px;
  background: var(--surface);
  border: 1px solid var(--line);
}

.oss-csum-row {
  display: flex;
  justify-content: space-between;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 12.5px;
  color: var(--muted);
  margin-bottom: 8px;
}

.oss-csum-tot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid var(--line);
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
}

.oss-csum-tot span { font-size: 13.5px; font-weight: 600; color: var(--text); }

.oss-csum-tot b {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--gold-deep);
}

.oss-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  padding: 15px;
  border-radius: 13px;
  background: var(--gold-grad);
  color: #fff;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 10px 24px rgba(133, 124, 85, 0.35);
  cursor: pointer;
}

/* ---------- Checkout ---------- */

.oss-cout {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.oss-creditcard {
  position: relative;
  border-radius: 16px;
  padding: 20px;
  aspect-ratio: 1.6;
  max-height: 180px;
  background: var(--gold-grad);
  color: #fff;
  overflow: hidden;
  box-shadow: 0 16px 34px -12px rgba(133, 124, 85, 0.55);
}

.oss-creditcard::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.oss-creditcard::after {
  content: '';
  position: absolute;
  bottom: -50%;
  left: -10%;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.oss-cc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
}

.oss-cc-chip {
  width: 34px;
  height: 26px;
  border-radius: 6px;
  background: linear-gradient(135deg, #f4e4bc, #d4af37);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
}

.oss-cc-brand {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1em;
  opacity: 0.9;
}

.oss-cc-num {
  position: relative;
  margin-top: 22px;
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 16px;
  letter-spacing: 0.18em;
  font-weight: 500;
}

.oss-cc-bottom {
  position: relative;
  display: flex;
  justify-content: space-between;
  margin-top: 14px;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 10px;
  opacity: 0.85;
}

.oss-cc-bottom b {
  display: block;
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 12px;
  letter-spacing: 0.05em;
  margin-top: 2px;
  opacity: 1;
}

.oss-pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px;
  border-radius: 12px;
  background: var(--gold-grad);
  color: #fff;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 10px 22px rgba(133, 124, 85, 0.3);
  cursor: pointer;
}

.oss-pay-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }

/* ---------- Admin ---------- */

.oss-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 14px;
}

.oss-stat {
  padding: 13px 14px;
  border-radius: 13px;
  background: var(--surface);
  border: 1px solid var(--line);
  position: relative;
  overflow: hidden;
}

.oss-stat::after {
  content: '';
  position: absolute;
  right: -14px;
  bottom: -14px;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--gold-tint);
}

.oss-stat-ico {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: var(--gold-grad);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 9px;
  position: relative;
  box-shadow: 0 4px 10px rgba(133, 124, 85, 0.3);
}

.oss-stat-ico svg { width: 14px; height: 14px; stroke: currentColor; }

.oss-sl {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 10px;
  color: var(--faint);
  margin-bottom: 2px;
  position: relative;
}

.oss-sv {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 17px;
  font-weight: 700;
  position: relative;
  color: var(--text);
}

.oss-sv em {
  font-size: 9.5px;
  font-style: normal;
  color: var(--green);
  font-weight: 600;
  margin-left: 4px;
}

.oss-admin-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.oss-lbl {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 11px;
  color: var(--faint);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.oss-addbtn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 8px 14px;
  border-radius: 9px;
  background: var(--gold-grad);
  color: #fff;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 5px 12px rgba(133, 124, 85, 0.3);
}

.oss-addbtn span { font-size: 14px; line-height: 1; }

.oss-order {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  border-radius: 12px;
  background: var(--surface);
  margin-bottom: 9px;
  transition: background 0.25s ease;
}

.oss-order:hover { background: var(--gold-tint); }

.oss-oimg {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold-soft);
}

.oss-oimg .oss-prod { width: 50%; height: 50%; }

.oss-oinfo { flex: 1; }

.oss-on {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text);
}

.oss-oid {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 10px;
  color: var(--faint);
}

.oss-ostatus {
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 9.5px;
  font-weight: 600;
  padding: 5px 11px;
  border-radius: 999px;
}

.oss-ostatus.done { background: var(--green-tint); color: var(--green); }
.oss-ostatus.wait { background: var(--gold-tint); color: var(--gold-deep); }

.oss-op {
  font-family: 'PP Neue Montreal', 'Helvetica Neue', Arial, sans-serif;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--gold-deep);
  min-width: 46px;
  text-align: right;
}

/* ---------- Caption ---------- */

.oss-caption {
  max-width: 600px;
  margin: 18px auto 0;
  text-align: center;
  font-family: 'FiraGO', sans-serif;
  font-feature-settings: 'case' on;
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--muted);
  animation: oss-fade 0.35s ease both;
}

/* ---------- Responsive / mobile ---------- */

@media (max-width: 600px) {
  .oss-container { padding: 80px 16px; }

  .oss-header { margin-bottom: 32px; }

  /* header wraps: brand + icons top row, nav scrolls below */
  .oss-hdr {
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px 14px;
  }

  .oss-nav {
    order: 3;
    width: 100%;
    margin: 0;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .oss-nav::-webkit-scrollbar { display: none; }

  .oss-hdr-icons { margin-left: auto; }

  .oss-navbtn {
    flex-shrink: 0;
    padding: 7px 12px;
    font-size: 12px;
  }

  .oss-view { padding: 14px 14px 18px; }

  /* catalog: 3 tight cols still fit; drop to smaller text */
  .oss-grid { gap: 9px; }

  .oss-pmeta { padding: 9px 9px 10px; }

  .oss-pn { font-size: 11px; }

  .oss-pp { font-size: 12px; }

  .oss-padd { width: 23px; height: 23px; font-size: 15px; }

  .oss-pfav { width: 21px; height: 21px; top: 6px; right: 6px; }

  .oss-catrow2 { padding: 11px 12px; gap: 9px; }

  .oss-catrow2-txt { font-size: 11.5px; }

  .oss-creditcard { max-height: 165px; padding: 18px; }

  .oss-cc-num { font-size: 14px; letter-spacing: 0.14em; margin-top: 18px; }

  .oss-stats { gap: 7px; }

  .oss-stat { padding: 11px 11px; }

  .oss-sv { font-size: 15px; }

  .oss-sv em { display: block; margin-left: 0; margin-top: 2px; }

  .oss-addbtn { padding: 7px 11px; font-size: 11px; }
}

@media (max-width: 380px) {
  .oss-brand-name { font-size: 13px; }
  .oss-navbtn { padding: 6px 10px; font-size: 11.5px; }
  .oss-pn { font-size: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  .oss-view,
  .oss-caption,
  .oss-navbtn::after,
  .oss-pcard,
  .oss-order,
  .oss-hicon {
    animation: none;
    transition: none;
  }
}